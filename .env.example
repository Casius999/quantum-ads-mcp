# Quantum ADS MCP — configuration (November 2026). PLACEHOLDERS ONLY — never commit real values.
# The server reads process environment only: set these in your MCP client's `env` block (or export
# them before launch). A copy named .env (gitignored) is what tests/live_smoke reads.
# Every connector whose credentials resolve below is wired at startup; the others answer
# BACKEND_NOT_CONFIGURED. See skill/quantum-ads/references/auth-and-guardrails.md.

# --- Google Ads -------------------------------------------------------------------------------
GOOGLE_ADS_USE_PROTO_PLUS=True
GOOGLE_ADS_API_VERSION=v26

GOOGLE_ADS_DEVELOPER_TOKEN=INSERT_DEVELOPER_TOKEN
GOOGLE_ADS_CLIENT_ID=INSERT_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=INSERT_CLIENT_SECRET
GOOGLE_ADS_REFRESH_TOKEN=INSERT_REFRESH_TOKEN

# Optional — manager (MCC) account, digits only
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Other Google connectors (GA4, GTM, Merchant, Data Manager, Search Console, YouTube, -------
# --- DV360, CM360, SA360, ADH, Business Profile, Workspace) -----------------------------------
# Optional dedicated OAuth credential; when unset the GOOGLE_ADS_* client + refresh token are used.
# The refresh token must carry the scopes of the connectors you call.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# GCP project: required for BigQuery, Vertex AI, Cloud Translation/Language, reCAPTCHA;
# also sent as the quota/billing project by the other Google connectors.
GOOGLE_CLOUD_PROJECT=
# Vertex endpoint location (default global)
GOOGLE_VERTEX_LOCATION=

# --- Looker (API3 credentials) ----------------------------------------------------------------
LOOKERSDK_BASE_URL=
LOOKERSDK_CLIENT_ID=
LOOKERSDK_CLIENT_SECRET=

# --- Free text-to-video (Hugging Face ZeroGPU Spaces) ---------------------------------------
# Optional free Hugging Face account token: ~5 min/day of GPU instead of ~2 anonymous.
HF_TOKEN=

# --- Free creative fallback (used when Vertex is unavailable or unbilled) -------------------
# Any OpenAI-compatible endpoint: NVIDIA NIM, OVHcloud AI Endpoints (works without a key at
# 2 requests/min), a local LM Studio / Ollama... Text uses /chat/completions; images use
# /images/generations when QUANTUM_ADS_IMAGE_MODEL is set, then free FLUX on Hugging Face.
# QUANTUM_ADS_LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# QUANTUM_ADS_LLM_API_KEY=
# QUANTUM_ADS_LLM_MODEL=Mistral-Small-3.2-24B-Instruct-2506
# QUANTUM_ADS_IMAGE_MODEL=stable-diffusion-xl-base-v10

# --- Remote serving with "Sign in with Google" (each user acts with their own Google token) ---
# QUANTUM_ADS_AUTH=google
# QUANTUM_ADS_GOOGLE_CLIENT_ID=....apps.googleusercontent.com   # Web client, redirect <public url>/auth/callback
# QUANTUM_ADS_GOOGLE_CLIENT_SECRET=
# QUANTUM_ADS_GOOGLE_ALLOWED=@youragency.com                     # required allowlist (e-mails, @domains)
# QUANTUM_ADS_GOOGLE_WRITERS=lead@youragency.com                 # may write; everyone else reads
# QUANTUM_ADS_JWT_SIGNING_KEY=                                   # stable key for issued MCP tokens
# See docs/DEPLOY.md.

# --- Remote serving: quantum-ads-mcp serve --transport http (OAuth 2.1) ----------------------
# Exactly one of: your identity provider's JWKS (+ issuer) ...
# QUANTUM_ADS_OAUTH_JWKS_URI=https://idp.example/.well-known/jwks.json
# QUANTUM_ADS_OAUTH_ISSUER=https://idp.example
# ... or the built-in issuer's public key (quantum-ads-mcp keygen prints it).
# QUANTUM_ADS_OAUTH_PUBLIC_KEY_FILE=~/.quantum-ads/issuer/issuer_ed25519.pub.pem
# QUANTUM_ADS_PUBLIC_URL=https://ads.agency.example   # token audience = <public url>/mcp
# QUANTUM_ADS_TENANTS_SECRET=quantum-ads-tenants      # per-tenant credentials in Secret Manager, or
# QUANTUM_ADS_TENANTS_FILE=tenants.json               # in a file (neither = single tenant)
# QUANTUM_ADS_HTTP_PORT=8000

# --- Observability (uv sync --extra observability) ------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318   # OTLP/HTTP trace export
# QUANTUM_ADS_LOG_CALLS=false                         # silence per-call JSON lines on stderr

# --- Agent autonomy and MCP features -------------------------------------------------------
# auto = validate_only then apply in one call (agent decides); confirm = two-call preview/commit
QUANTUM_ADS_WRITE_MODE=auto
# QUANTUM_ADS_POLICY_FILE=policy.json   # optional guardrails (see auth-and-guardrails.md)
# QUANTUM_ADS_TOOL_SEARCH=true          # expose search_tools/call_tool instead of 131 tools
# QUANTUM_ADS_TASKS=true                # long-running tools as MCP tasks (uv sync --extra tasks)

# --- Server ---------------------------------------------------------------------------------
# Optional subset of connectors to mount, e.g. google_ads,ga4,gtm (default: all)
QUANTUM_ADS_CONNECTORS=
# Signed, hash-chained audit ledger directory (default ~/.quantum-ads/audit; empty = in memory)
# QUANTUM_ADS_AUDIT_DIR=~/.quantum-ads/audit
# Safety: read-only by default. Set to false only when guarded writes are intended.
QUANTUM_ADS_READ_ONLY=true
