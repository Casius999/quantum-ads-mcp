# Quantum ADS MCP — configuration (November 2026). PLACEHOLDERS ONLY — never commit real values.
# The server reads process environment only: set these in your MCP client's `env` block (or export
# them before launch). A copy named .env (gitignored) is what tests/live_smoke reads.
# Every connector whose credentials resolve below is wired at startup; the others answer
# BACKEND_NOT_CONFIGURED. See skill/quantum-ads/references/auth-and-guardrails.md.

# --- Google Ads -------------------------------------------------------------------------------
GOOGLE_ADS_USE_PROTO_PLUS=True
GOOGLE_ADS_API_VERSION=v26

GOOGLE_ADS_DEVELOPER_TOKEN=INSERT_DEVELOPER_TOKEN
GOOGLE_ADS_CLIENT_ID=INSERT_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=INSERT_CLIENT_SECRET
GOOGLE_ADS_REFRESH_TOKEN=INSERT_REFRESH_TOKEN

# Optional — manager (MCC) account, digits only
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Other Google connectors (GA4, GTM, Merchant, Data Manager, Search Console, YouTube, -------
# --- DV360, CM360, SA360, ADH, Business Profile, Workspace) -----------------------------------
# Optional dedicated OAuth credential; when unset the GOOGLE_ADS_* client + refresh token are used.
# The refresh token must carry the scopes of the connectors you call.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# GCP project: required for BigQuery, Vertex AI, Cloud Translation/Language, reCAPTCHA;
# also sent as the quota/billing project by the other Google connectors.
GOOGLE_CLOUD_PROJECT=
# Vertex endpoint location (default global)
GOOGLE_VERTEX_LOCATION=

# --- Looker (API3 credentials) ----------------------------------------------------------------
LOOKERSDK_BASE_URL=
LOOKERSDK_CLIENT_ID=
LOOKERSDK_CLIENT_SECRET=

# --- Server ---------------------------------------------------------------------------------
# Optional subset of connectors to mount, e.g. google_ads,ga4,gtm (default: all)
QUANTUM_ADS_CONNECTORS=
# Signed, hash-chained audit ledger directory (default ~/.quantum-ads/audit; empty = in memory)
# QUANTUM_ADS_AUDIT_DIR=~/.quantum-ads/audit
# Safety: read-only by default. Set to false only when guarded writes are intended.
QUANTUM_ADS_READ_ONLY=true
